<style>
  .user {
    color: #ff00ff;
    font-weight: bold;
    text-shadow: 0 0 5px rgba(255, 0, 255, 0.3);
  }

  .path {
    color: #00ffff;
    font-weight: bold;
    text-shadow: 0 0 5px rgba(0, 255, 255, 0.3);
  }

  .colors-line {
    align-items: center;
  }

  .color-blocks {
    display: flex;
    gap: 4px;
  }

  .color-block {
    width: 16px;
    height: 16px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .color-1 {
    background: #ff5f5f;
    box-shadow: 0 0 5px rgba(255, 95, 95, 0.3);
  }
  .color-2 {
    background: #5fff5f;
    box-shadow: 0 0 5px rgba(95, 255, 95, 0.3);
  }
  .color-3 {
    background: #ffff5f;
    box-shadow: 0 0 5px rgba(255, 255, 95, 0.3);
  }
  .color-4 {
    background: #5f5fff;
    box-shadow: 0 0 5px rgba(95, 95, 255, 0.3);
  }
  .color-5 {
    background: #ff5fff;
    box-shadow: 0 0 5px rgba(255, 95, 255, 0.3);
  }
  .color-6 {
    background: #5fffff;
    box-shadow: 0 0 5px rgba(95, 255, 255, 0.3);
  }
  .color-7 {
    background: #ffffff;
    box-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
  }
  .color-8 {
    background: #808080;
    box-shadow: 0 0 5px rgba(128, 128, 128, 0.3);
  }

  /* Glow effects for 80s aesthetic */
</style>
