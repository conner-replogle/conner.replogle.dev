   ║  ├┬┘├┤ ├─┘│  │ ││ ┬│  ├┤              ║
   ║  ┴└─└─┘┴  ┴─┘└─┘└─┘┴─┘└─┘             ║
   ║                                       ║
   ╚═══════════════════════════════════════╝
        </pre>
      </div>
      
      <div class="system-info">
        <div class="info-line" data-delay="0">
          <span class="key">User:</span>
          <span class="value">Conner Replogle</span>
        </div>
        <div class="info-line" data-delay="100">
          <span class="key">Role:</span>
          <span class="value">Software Engineer Intern</span>
        </div>
        <div class="info-line" data-delay="200">
          <span class="key">Location:</span>
          <span class="value">Magnolia, TX</span>
        </div>
        <div class="info-line" data-delay="300">
          <span class="key">Education:</span>
          <span class="value">UT Dallas - Computer Engineering</span>
        </div>
        <div class="info-line" data-delay="400">
          <span class="key">Internship:</span>
          <span class="value">Cloudflare SWE Intern 2025 Summer</span>
        </div>
        <div class="info-line" data-delay="500">
          <span class="key">Hobbies:</span>
          <span class="value">Golf, MTB, Gym</span>
        </div>
        <div class="info-line" data-delay="600">
          <span class="key">Languages:</span>
          <span class="value">JavaScript, TypeScript, Python, Go</span>
        </div>
        <div class="info-line" data-delay="700">
          <span class="key">Frontend:</span>
          <span class="value">React, Next.js, Astro, Tailwind</span>
        </div>
        <div class="info-line" data-delay="800">
          <span class="key">Backend:</span>
          <span class="value">Node.js, Workers, Edge Computing</span>
        </div>
        <div class="info-line" data-delay="900">
          <span class="key">Cloud:</span>
          <span class="value">Cloudflare, AWS, Serverless</span>
        </div>
        <div class="info-line" data-delay="1000">
          <span class="key">Focus:</span>
          <span class="value">Web Performance & Edge Computing</span>
        </div>
        <div class="info-line" data-delay="1100">
          <span class="key">Status:</span>
          <span class="value">Cloudflare Intern Summer 2025</span>
        </div>
        <div class="info-line" data-delay="1200">
          <span class="key">GitHub:</span>
          <span class="value">
            <a href="https://github.com/conner-replogle" target="_blank" class="terminal-link">
              github.com/conner-replogle
            </a>
          </span>
        </div>
        <div class="info-line" data-delay="1300">
          <span class="key">Resume:</span>
          <span class="value">
            <a href="/conner-replogle.pdf" target="_blank" class="terminal-link">
              ./conner-replogle.pdf
            </a>
          </span>
        </div>
        <div class="info-line" data-delay="1400">
          <span class="key">Portfolio:</span>
          <span class="value">
            <a href="#projects" class="terminal-link">
              ~/projects/
            </a>
          </span>
        </div>
        <div class="info-line" data-delay="1500">
          <span class="key">LinkedIn:</span>
          <span class="value">
            <a href="https://linkedin.com/in/conner-replogle" target="_blank" class="terminal-link">
              linkedin.com/in/conner-replogle
            </a>
          </span>
        </div>
        <div class="info-line" data-delay="1600">
          <span class="key">Email:</span>
          <span class="value">
            <a href="mailto:conner.replogle.jobs@replogle.dev" class="terminal-link">
              conner.replogle.jobs@replogle.dev
            </a>
          </span>
        </div>
        <div class="info-line colors-line" data-delay="1700">
          <span class="key">Colors:</span>
          <span class="color-blocks">
            <span class="color-block color-1"></span>
            <span class="color-block color-2"></span>
            <span class="color-block color-3"></span>
            <span class="color-block color-4"></span>
