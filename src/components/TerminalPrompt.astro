---
type Props = {
  blinking?: boolean;
  directory?: string;
};
const { blinking = false, directory = '' } = Astro.props;
---

<div class="terminal-prompt">
  <span class="prompt-user">conner</span><span class="prompt-at">@</span><span class="prompt-host">portfolio</span><span class="prompt-sep">:</span><span class="prompt-path">~{directory}</span><span class="prompt-sep">$</span>{' '}
  <slot />
  {blinking && <span class="cursor">_</span>}
</div>

<style>
  .terminal-prompt {
    font-size: 13.5px;
    line-height: 1.6;
    color: #c9d1d9;
    margin: 4px 0;
  }

  .prompt-user {
    color: #a5b4fc;
    font-weight: 600;
  }

  .prompt-at {
    color: rgba(165, 180, 252, 0.5);
  }

  .prompt-host {
    color: #a5b4fc;
    font-weight: 600;
  }

  .prompt-sep {
    color: rgba(201, 209, 217, 0.5);
  }

  .prompt-path {
    color: #86efac;
    font-weight: 500;
  }

  .cursor {
    color: #86efac;
    animation: blink 1.1s step-end infinite;
    margin-left: 1px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
