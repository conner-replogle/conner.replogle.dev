---
// Neofetch Component

type Props = {
  entries: Record<string, { text: string; href?: string }>;
};
const { entries } = Astro.props;
---

<div class="neofetch-display">
  <div class="ascii-art">
    <pre
      class="ascii-logo">
        <slot name="logo">
       ╔═══════════════════════════════════════╗
       ║                                       ║
       ║   ██████╗ ██████╗                     ║
       ║  ██╔════╝ ██╔══██╗                    ║
       ║  ██║      ██████╔╝                    ║
       ║  ██║      ██╔══██╗                    ║
       ║  ╚██████╗ ██║  ██║                    ║
       ║   ╚═════╝ ╚═╝  ╚═╝                    ║
       ║                                       ║
       ║  ┌─┐┌─┐┌┐┌┌┐┌┌─┐┬─┐                   ║
       ║  │  │ │││││││├┤ ├┬┘                   ║
       ║  └─┘└─┘┘└┘┘└┘└─┘┴└─                   ║
       ║                                       ║
       ║  ┬─┐┌─┐┌─┐┬  ┌─┐┌─┐┬  ┌─┐             ║
       ║  ├┬┘├┤ ├─┘│  │ ││ ┬│  ├┤              ║
       ║  ┴└─└─┘┴  ┴─┘└─┘└─┘┴─┘└─┘             ║
       ║                                       ║
       ╚═══════════════════════════════════════╝
       </slot>
    </pre>
  </div>

  <div class="system-info">
    {
      Object.entries(entries).map(([key, { href, text }], i) => (
        <div class="info-line" data-delay={i * 100}>
          <span class="key terminal-text">{key}:</span>
          {href && href.length != 0 ? (
            <span class="value">
              <a class="terminal-text" href={href}>
                {text}
              </a>
            </span>
          ) : (
            <span class="value terminal-text">{text}</span>
          )}
        </div>
      ))
    }
  </div>
</div>

<style>
  .neofetch-display {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin: 20px 0;
  }

  .ascii-art {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ascii-logo {
    color: #ff00ff;
    font-size: 10px;
    line-height: 1.1;
    text-shadow: 0 0 10px rgba(255, 0, 255, 0.3);
    background: linear-gradient(135deg, #ff00ff 0%, #00ffff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
    font-weight: bold;
  }

  .system-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .neofetch-display {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ascii-logo {
      font-size: 7px;
    }

    .key {
      min-width: 100px;
    }

    .value {
      word-break: break-word;
    }

    .info-line {
      gap: 4px;
    }
  }

  @media (max-width: 480px) {
    .ascii-art {
      display: none;
    }

    .key {
      min-width: 80px;
    }

    .value {
      text-wrap: initial;
    }
  }

  .info-line {
    display: flex;
    font-size: 14px;
    line-height: 1.4;
    opacity: 0;
    transform: translateX(-10px);
    animation: fadeInSlide 0.5s ease-out forwards;
  }

  .key {
    color: #00ffff;
    font-weight: bold;
    min-width: 100px;
    text-shadow: 0 0 5px rgba(0, 255, 255, 0.3);
  }

  .value {
    color: #ffffff;
    text-shadow: 0 0 3px rgba(255, 255, 255, 0.2);
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
