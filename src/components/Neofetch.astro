---
type Props = {
  entries: Record<string, { text: string; href?: string }>;
};
const { entries } = Astro.props;
---

<div class="neofetch-display">
  <div class="ascii-art">
    <pre class="ascii-logo">
╔═══════════════════════════════════════╗
║                                       ║
║   ██████╗ ██████╗                     ║
║  ██╔════╝ ██╔══██╗                    ║
║  ██║      ██████╔╝                    ║
║  ██║      ██╔══██╗                    ║
║  ╚██████╗ ██║  ██║                    ║
║   ╚═════╝ ╚═╝  ╚═╝                    ║
║                                       ║
║  ┌─┐┌─┐┌┐┌┌┐┌┌─┐┬─┐                   ║
║  │  │ │││││││├┤ ├┬┘                   ║
║  └─┘└─┘┘└┘┘└┘└─┘┴└─                   ║
║                                       ║
║  ┬─┐┌─┐┌─┐┬  ┌─┐┌─┐┬  ┌─┐             ║
║  ├┬┘├┤ ├─┘│  │ ││ ┬│  ├┤              ║
║  ┴└─└─┘┴  ┴─┘└─┘└─┘┴─┘└─┘             ║
║                                       ║
╚═══════════════════════════════════════╝
    </pre>
  </div>

  <div class="system-info">
    {
      Object.entries(entries).map(([key, { href, text }], i) => (
        <div class="info-line" style={`animation-delay: ${i * 60}ms`}>
          <span class="key">{key.toLowerCase()}</span>
          {href && href.length != 0 ? (
            <a class="value link" href={href} target={href.startsWith('http') ? '_blank' : undefined}>
              {text}
            </a>
          ) : (
            <span class="value">{text}</span>
          )}
        </div>
      ))
    }
  </div>
</div>

<style>
  .neofetch-display {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 24px;
    margin: 16px 0 20px 0;
    align-items: center;
    justify-items: start;
  }

  .ascii-art {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ascii-logo {
    color: #a5b4fc;
    font-size: 9px;
    line-height: 1.1;
    margin: 0;
    font-weight: 600;
    opacity: 0.8;
    letter-spacing: 0.5px;
  }

  .system-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .info-line {
    display: flex;
    font-size: 13px;
    line-height: 1.5;
    align-items: center;
    opacity: 0;
    animation: fadeIn 0.4s ease-out forwards;
  }

  .key {
    color: #a5b4fc;
    font-weight: 600;
    min-width: 96px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .key::after {
    content: ':';
    color: rgba(165, 180, 252, 0.5);
  }

  .value {
    color: #c9d1d9;
  }

  .value.link {
    color: #7dd3fc;
    text-decoration: none;
    transition: opacity 0.15s ease;
    border-bottom: 1px solid rgba(125, 211, 252, 0.2);
  }

  .value.link:hover {
    opacity: 0.75;
    border-bottom-color: rgba(125, 211, 252, 0.5);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (max-width: 640px) {
    .neofetch-display {
      grid-template-columns: 1fr;
      gap: 18px;
      justify-items: center;
    }

    .ascii-logo {
      font-size: 7.5px;
    }

    .info-line {
      font-size: 12px;
    }

    .key {
      min-width: 84px;
    }
  }

  @media (max-width: 420px) {
    .ascii-art {
      display: none;
    }

    .key {
      min-width: 76px;
    }
  }
</style>
