---
import type { idText } from 'typescript';
import TerminalPrompt from './TerminalPrompt.astro';
import TerminalWindow from './TerminalWindow.astro';
import Neofetch from './Neofetch.astro';

interface Project {
  id: string;
  title: string;
  description: string;
  technologies: string[];
  github?: string;
  demo?: string;
  status?: 'completed' | 'in-progress' | 'planned';
  featured?: boolean;
}
interface Props {
  projects: Project[];
  activeProject?: Project;
}

const { projects, activeProject } = Astro.props;

const statusColors = {
  completed: '#00ff00',
  'in-progress': '#ffff00',
  planned: '#ff00ff',
};

const statusIcons = {
  completed: '✓',
  'in-progress': '⚠',
  planned: '◯',
};
---

<TerminalPrompt directory="/projects"> ls ./ </TerminalPrompt>
<a class="terminal-text" href={`/`}> .. </a>
<br />

{
  projects.map(({ title, id, description, technologies, github, demo, status, featured }) => (
    <>
      <a class="terminal-text" href={`/projects/${id}`}>
        {title}.md
      </a>
      <br />
    </>
  ))
}
{
  activeProject && (
    <>
      <TerminalPrompt directory="/projects">neofetch ./{activeProject.id}.md</TerminalPrompt>
      <Neofetch
        entries={{
          Title: {
            text: activeProject.title,
          },
          Description: {
            text: activeProject.description,
          },
          Demo: {
            text: activeProject.demo ?? 'Not available',
          },
        }}
      />
    </>
  )
}

<TerminalPrompt blinking />

<style>
  .project-body {
    padding: 20px;
    background: #0a0a0a;
  }

  </Neofetch > </TerminalWindow > <style > .project-body {
    padding: 20px;
    background: #0a0a0a;
  }
</style>
