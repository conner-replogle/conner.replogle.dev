---
import TerminalPrompt from './TerminalPrompt.astro';
import TerminalWindow from './TerminalWindow.astro';

interface Project {
  title: string;
  description: string;
  technologies: string[];
  github?: string;
  demo?: string;
  status?: 'completed' | 'in-progress' | 'planned';
  featured?: boolean;
}
interface Props{
    projects: Project[]
}

const {projects } = Astro.props;

const statusColors = {
  completed: '#00ff00',
  'in-progress': '#ffff00',
  planned: '#ff00ff'
};

const statusIcons = {
  completed: '✓',
  'in-progress': '⚠',
  planned: '◯'
};
---

<TerminalWindow title="conner@projects:~">
    <TerminalPrompt>
      ls ./projects
    </TerminalPrompt>
    {projects.map(({ title, description, technologies, github, demo, status, featured }) => (
      <a class="terminal-text" href={`/projects/${title}`}>{title}.md</a><br/>
    ))}
  </div>
</TerminalWindow>

<style>
  .project-body {
    padding: 20px;
    background: #0a0a0a;
  }

</style>
