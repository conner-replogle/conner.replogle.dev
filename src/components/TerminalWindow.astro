---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="terminal-window w-full h-full overflow-y-scroll">
  <!-- <div class="terminal-header"> -->
  <!--   <div class="terminal-controls"> -->
  <!--     <div class="control red"></div> -->
  <!--     <div class="control yellow"></div> -->
  <!--     <div class="control green"></div> -->
  <!--   </div> -->
  <!--   <div class="terminal-title">{title}</div> -->
  <!-- </div> -->
  <div class="terminal-body h-full">
    <slot />
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .terminal-body {
      padding: 15px;
    }

    .terminal-header {
      padding: 10px 12px;
    }

    .terminal-title {
      font-size: 12px;
    }
  }

  /* .terminal-window { */
  /*   animation: subtle-glow 3s ease-in-out infinite alternate; */
  /* } */
  /**/
  /* @keyframes subtle-glow { */
  /*   0% { */
  /*     box-shadow: */
  /*       0 0 50px rgba(0, 255, 255, 0.3), */
  /*       0 0 100px rgba(255, 0, 255, 0.2), */
  /*       inset 0 0 0 1px rgba(0, 255, 255, 0.1); */
  /*   } */
  /*   100% { */
  /*     box-shadow: */
  /*       0 0 60px rgba(0, 255, 255, 0.4), */
  /*       0 0 120px rgba(255, 0, 255, 0.3), */
  /*       inset 0 0 0 1px rgba(0, 255, 255, 0.2); */
  /*   } */
  /* } */
  .terminal-body {
    padding: 20px;
    background: #0a0a0a;
    min-height: 500px;
    overflow-y: auto; /* Enable scrolling */
  }
  .terminal-window {
    font-family: 'Courier New', 'Monaco', 'Menlo', monospace;
    background: linear-gradient(135deg, #0f0f0f 0%, #1a1a1a 100%);
    border-radius: 12px;
    max-width: 900px;
    position: relative;
    overflow: hidden;
  }

  .terminal-header {
    background: linear-gradient(135deg, #2a2a2a 0%, #1f1f1f 100%);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(0, 255, 255, 0.2);
  }

  .terminal-controls {
    display: flex;
    gap: 8px;
  }

  .control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
  }

  .control.red {
    background: linear-gradient(135deg, #ff5f5f 0%, #ff2d2d 100%);
    box-shadow: 0 0 10px rgba(255, 95, 95, 0.3);
  }

  .control.yellow {
    background: linear-gradient(135deg, #ffff5f 0%, #ffff2d 100%);
    box-shadow: 0 0 10px rgba(255, 255, 95, 0.3);
  }

  .control.green {
    background: linear-gradient(135deg, #5fff5f 0%, #2dff2d 100%);
    box-shadow: 0 0 10px rgba(95, 255, 95, 0.3);
  }

  .terminal-title {
    color: #00ffff;
    font-size: 14px;
    font-weight: bold;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
  }
</style>
