---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectTerminal from '~/components/ProjectTerminal.astro';
import TerminalPrompt from '~/components/TerminalPrompt.astro';
import TerminalWindow from '~/components/TerminalWindow.astro';

import type { CollectionEntry } from 'astro:content';
export const getStaticPaths = async () => {
  const projects = await getCollection('project');
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
};

const { slug } = Astro.params;

const projects = await getCollection('project');

// Sort projects: featured first, then by date
const sortedProjects: CollectionEntry<'project'>[] = projects
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;

    const dateA = a.data.endDate || a.data.startDate || new Date(0);
    const dateB = b.data.endDate || b.data.startDate || new Date(0);
    return dateB.getTime() - dateA.getTime();
  })

const statusColors = {
  completed: '#00ff00',
  'in-progress': '#ffff00',
  planned: '#ff00ff',
};

const statusIcons = {
  completed: '✓',
  'in-progress': '⚠',
  planned: '◯',
};

console.log(`Project slug: ${slug}`);

const project = sortedProjects.find((p) => p.slug === slug);
var metadata;
if (project) {
  metadata = {
    title: `${project.data.title} | Conner Replogle`,
    description: project.data.description,
  };
} else {
  metadata = {
    title: `Projects | Conner Replogle`,
    description: 'All of my projects',
  };
}

const projectsData = sortedProjects.map((p) => ({
  slug: p.slug,
  ...p.data,
}));
---

<Layout metadata={metadata}>
  <TerminalWindow title="~/projects">
    <TerminalPrompt> cd ./projects </TerminalPrompt>
    <!-- Project Terminal -->
    <ProjectTerminal projects={projectsData} activeProject={project} />
  </TerminalWindow>
</Layout>
