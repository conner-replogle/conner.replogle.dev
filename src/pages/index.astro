---
import Layout from '../layouts/PageLayout.astro';

import Hero from '../components/widgets/Hero.astro';
import Content from '../components/widgets/Content.astro';
import Features3 from '../components/widgets/Features3.astro';
import BlogLatestPosts from '../components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '../utils/permalinks';
import SnakeImage from '../assets/images/SnakeIcon.png';
import GritlyImage from '../assets/images/GritlyIcon.png';

const metadata = {
  title: 'Conner Replogle | Portfolio',
};
---

<Layout metadata={metadata}>
 

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Conner Replogle"
    tagline="Portfolio"
    actions={[{ variant: 'primary', text: 'Contact me', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      I'm a Software & Hardware Engineer passionate about all things tech. <br /> Currently obtaining a Computer Engineering degree at <br/> The University of Texas at Dallas.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Features3
    title="Skills"
    subtitle="I tend to jump around between different areas of Computer Engineering, but here are some of my skills."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'PCB Design',
        description: 'KiCad, Altium Designer',
      },
      {
        title: 'Website Development',
        description: 'React, Next, CSS, HTML, TS, JS',
      },
      {
        title: 'App Developement',
        description: 'React Native, Flutter and Swift.',
      },
      {
        title: 'Backend Development',
        description: 'GO, Rust, Node js, Python',
      },
      {
        title: 'Embedded Languages',
        description: 'C, C++, Rust, MicroPython',
      },
      {
        title: 'Embedded Boards',
        description: 'ESP32, STM32, Raspberry Pi, Arduino',
      },
     
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="porfolio"
    title="My Projects"
    subtitle="What have I been up to?"
    isReversed
    items={[
      {
        title: 'Description',
        description:
          'Using reinforcement learning and neural networks, I trained an AI to play the classic game of snake. The AI learned to navigate the game board, avoid obstacles, and consume food to grow longer. The project aimed to demonstrate the capabilities of AI in gaming environments.',
      },
      
    ]}
    image={{
      src: SnakeImage,
      alt: 'Tech Design Image',
      width: 100,
      height: 100,
      widths: [100],
      sizes: "(max-width: 768px) 100vw, 432px",
      style: "image-rendering: pixelated;",
    }}
    callToAction={{
      target: '_blank',
      text: 'Go to the project',
      icon: 'tabler:chevron-right',
      href: '#',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Snake AI<br /><span class="text-2xl">Training AI to play the game snake using reinforcement learning</span>
        
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'Description:',
        description:
          'React Native App that helps users track their daily, weekly or monthly habits. Released on the App Store. The app features a clean and intuitive interface, customizable habit tracking, and motivational reminders to keep users engaged.',
      },
      {
        title: 'Stack',
        description: `React Native, Expo, TypeScript, Sqlite`,
      },
    ]}
    image={{
      src: GritlyImage,
      alt: 'Gritly IOS App Icon',
    }}
    callToAction={{
      target: '_blank',
      text: 'Go to the project',
      icon: 'tabler:chevron-right',
      href: '#',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Project 2: <br /><span class="text-2xl">Gritly Habit Tracker</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'Description:',
        description: `Open source Indoor Security Camera, featuring motion detection, facial recognition, and selfhosted cloud storage. The camera is designed to be user-friendly, affordable, and secure. The project aimed to provide a privacy-focused alternative to commercial security cameras.`,
      },
      {
        title: 'Stack:',
        description: `Golang, React, Raspberry Pi, TensorFlow, Docker`,
      },
    ]}
    
    callToAction={{
      target: '_blank',
      text: 'Coming Soon',
      icon: 'tabler:chevron-right',
      href: '#',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Project 3: <br /><span class="text-2xl">SudoCam</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <!-- CallToAction Widget *********** -->

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="What have I been working on?"
    information={`I write about my experiences in the tech industry, my projects, and my thoughts on the latest trends.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
