---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectTerminal from '~/components/ProjectTerminal.astro';

const projects = await getCollection('project');

// Sort projects: featured first, then by date
const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  
  const dateA = a.data.endDate || a.data.startDate || new Date(0);
  const dateB = b.data.endDate || b.data.startDate || new Date(0);
  return dateB.getTime() - dateA.getTime();
}).map(project => ({
  title: project.data.title,
  description: project.data.description,
  technologies: project.data.technologies,
  github: project.data.github,
  demo: project.data.demo,
  status: project.data.status || 'planned',
  featured: project.data.featured || false
}));

const statusColors = {
  completed: '#00ff00',
  'in-progress': '#ffff00',
  planned: '#ff00ff'
};

const statusIcons = {
  completed: '✓',
  'in-progress': '⚠',
  planned: '◯'
};

const metadata = {
  title: 'Projects | Conner Replogle',
  description: 'A collection of my software development projects, from web applications to edge computing solutions.',
};
---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900 p-4">
    <div class="max-w-6xl mx-auto">
        <ProjectTerminal projects={sortedProjects}/>
    </div>
  </main>
</Layout>

